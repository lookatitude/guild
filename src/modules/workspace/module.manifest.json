{
  "schema_version": "guild.module_manifest.v1",
  "id": "workspace",
  "title": "Workspace Federation",
  "kind": "substrate",
  "implementation_mode": "workflow-backed",
  "description": "Owns umbrella/subrepo detection, workspace manifests, federated query, promotion, and workspace impact checks.",
  "depends_on": ["config", "knowledge", "state"],
