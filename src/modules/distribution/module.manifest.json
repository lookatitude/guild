  "depends_on": [
    "host-runtime",
    "kernel",
    "state"
  ],
  "owns": {
    "scripts": [
      "build-host-packages",
      "build-inventory",
      "build-verify",
      "check-bundle-determinism",
      "check-entrypoint-packaging",
      "check-module-ownership",
      "check-plugin-root-fallback",
      "check-roster-consistency",
      "codex-guild-prompt-bridge",
      "description-optimizer",
      "lib/command-registry",
      "lib/equivalence-contract",
      "lib/inventory-schema",
      "lib/module-resources",
      "lib/parity-contract",
      "lib/per-host-packaging",
      "lib/result-contracts",
      "lib/self-update",
      "lib/skill-source-transform",
      "lib/surface-manifest",
      "lib/update-check",
      "registry-rollup",
      "release-changelog",
      "sync-live-resources",
      "sync-module-resources",
      "verify-host-packages",
      "verify-installer"
    ]
  }
}
