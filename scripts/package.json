{
  "name": "guild-scripts",
  "private": true,
  "scripts": {
    "test": "npx jest --testPathPattern=__tests__ --no-coverage --runInBand",
    "build:inventory": "npx tsx build-inventory.ts",
    "build:hosts": "npx tsx build-host-packages.ts"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/fixtures/"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": { "module": "commonjs" } }]
    },
    "testTimeout": 30000
  }
}
