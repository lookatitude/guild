# Node
node_modules/
*.log

# Fixture .guild/ dirs must be tracked (they are static test fixtures, not live runtime state).
# These exemptions are non-negotiable — preserved verbatim per share-dot-guild constraints.
!benchmark/fixtures/**/.guild/
!benchmark/fixtures/**/.guild/**
!mcp-servers/guild-telemetry/fixtures/**/.guild/
!mcp-servers/guild-telemetry/fixtures/**/.guild/**
!mcp-servers/guild-telemetry/fixtures-v14/**/.guild/
!mcp-servers/guild-telemetry/fixtures-v14/**/.guild/**

# .guild/ — share-dot-guild policy (see docs/knowledge/decisions/guild-boundary-config-and-tracking.md Decision E)
.guild
!.guild/
!.guild/wiki/
!.guild/wiki/**
!.guild/initiatives/
!.guild/initiatives/**
!.guild/spec/
!.guild/spec/**
!.guild/plan/
!.guild/plan/**
!.guild/prd/
!.guild/prd/**
!.guild/team/
!.guild/team/**
!.guild/reflections/
!.guild/reflections/**
!.guild/evolve/
!.guild/evolve/**
!.guild/indexes/
!.guild/indexes/**
!.guild/workspace.json
!.guild/settings.json
!.guild/runs/
!.guild/runs/*/
!.guild/runs/*/handoffs/
!.guild/runs/*/handoffs/**
!.guild/runs/*/verify.md
!.guild/runs/*/review.md
!.guild/runs/*/provenance.json
!.guild/runs/*/summary.md
!.guild/runs/*/share-payloads.flag

# Re-deny operator-private / local-only sub-paths (D-SHR-4 + Decision G)
.guild/settings.local.json
.guild/hosts/
.guild/runs/*/events.ndjson
.guild/runs/*/logs/

# Nested .guild/ dirs (e.g. plugin/hooks/.guild/ from hook-test runs) — same
# local-only deny patterns at any depth. Followup for v2.1: fold into the
# main share-dot-guild block via `**/.guild/*` wildcard re-design.
**/.guild/runs/*/events.ndjson
**/.guild/runs/*/logs/
**/.guild/hosts/
**/.guild/settings.local.json
# plugin/hooks/.guild/ is transient hook-test telemetry — never shared
plugin/hooks/.guild/
hooks/.guild/

# Host-tool builtin-skill symlinks (operator-machine-specific; e.g. AionUI
# builtins symlinked into ~/.aionui-config). Not Guild's multi-host adapter
# layout — never part of the shipped plugin.
.codex/skills/
.gemini/skills/
.claude/skills/

# OS
.DS_Store

# Accidental root lockfile (scripts/, hooks/, mcp-servers/ have their own)
/package-lock.json

# Benchmark factory runtime artifacts (benchmark/ has its own package.json)
benchmark/runs/
benchmark/reports/internal/
benchmark/node_modules/
benchmark/coverage/
benchmark/ui/node_modules/
benchmark/ui/dist/
benchmark/ui/coverage/

# TypeScript incremental build cache
*.tsbuildinfo
