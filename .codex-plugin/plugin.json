{
  "name": "guild",
  "version": "2.7.0-beta.20",
  "mcpServers": {
    "guild-memory": {
      "type": "stdio",
      "command": "node",
      "args": [
        "runtime/guild-mcp.js",
        "wiki",
        "--no-cwd-fallback"
      ],
      "cwd": "."
    },
    "guild-telemetry": {
      "type": "stdio",
      "command": "node",
      "args": [
        "runtime/guild-mcp.js",
        "trace",
        "--no-cwd-fallback"
      ],
      "cwd": "."
    }
  }
}
